# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

# Long, random, secret string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# Port the API listens on.
PORT=3001

# Comma-separated list of origins allowed to call this API from the browser.
# Set this to wherever index.html is actually served from.
CORS_ORIGIN=http://localhost:5173

# Anthropic API key, if you want /api/generate-plan (the AI plan generator
# proxy) to work. Leave blank to run without AI generation — the app falls
# back to its built-in rule-based planner automatically.
ANTHROPIC_API_KEY=
